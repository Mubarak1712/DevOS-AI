# DevOS-AI Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file or real secrets to version control.

# ==============================================================================
# Client-Side Configuration (Vite Frontend - Safe for Browser)
# ==============================================================================

# Supabase Project URL and Anon/Public Key (Found in Supabase Project Settings > API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# GitHub OAuth App Client ID (Found in GitHub Developer Settings > OAuth Apps)
VITE_GITHUB_CLIENT_ID=your_github_oauth_client_id

# OAuth Callback Endpoint (Matches the authorization callback URL configured in GitHub)
VITE_GITHUB_REDIRECT_URI=http://localhost:5173/github/callback

# ==============================================================================
# Server-Side Secrets (Configured via `supabase secrets set <KEY>=<VALUE>`)
# DO NOT add these to your frontend bundle. Set them in Supabase Edge Functions.
# ==============================================================================

# GitHub OAuth Client Secret for secure server-side token exchange
# GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
# GITHUB_CLIENT_ID=your_github_oauth_client_id

# AI Studio Service Keys (Groq is primary LLM; Gemini is high-context fallback)
# GROQ_API_KEY=your_groq_api_key
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-2.0-flash

# Supabase Admin Secrets (Automatically populated in Supabase hosted runtime)
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# SUPABASE_ANON_KEY=your_supabase_anon_key
